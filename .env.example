# ---- App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=debug

# ---- Supabase (leave blank to run on const demo data from src/data)
# Reference: https://supabase.com/docs/guides/api/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# New Publishable key (replaces legacy anon key; safe for client / browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy anon key (backward-compatible fallback)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# New Secret key (replaces legacy service_role key; server-only, bypasses RLS)
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy service_role key (backward-compatible fallback)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Payments (keys live in env; admin toggles gateways on/off in the DB)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_BASE_URL=https://test.payu.in

# ---- Shipping
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_WEBHOOK_TOKEN=

# ---- Email / analytics
RESEND_API_KEY=
EMAIL_FROM=wavy <orders@wavy.store>
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA4_ID=
